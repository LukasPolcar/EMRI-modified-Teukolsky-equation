Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"h", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "NP"}]}], "}"}], ",", 
        RowBox[{"{", 
