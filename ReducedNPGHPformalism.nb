       RowBox[{
        RowBox[{"GHPWeightOf", "@", "sc"}], ",", "1"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"GHPWeightOf", "@", 
         RowBox[{"\[CapitalTheta]", "[", "ind", "]"}]}], ",", "2"}], "]"}], 
      "+", 
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"GHPWeightOf", "@", "sc"}], ",", "2"}], "]"}]}]}], "}"}]}], 
