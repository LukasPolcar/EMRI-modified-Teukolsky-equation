Cell[CellGroupData[{

Cell["Perturbing Directional Derivatives Rule ", "Subsection",
 CellChangeTimes->{{3.766833357598752*^9, 3.7668333813363*^9}, {
  3.766904397936077*^9, 3.7669045179130945`*^9}, {3.8927026089365788`*^9, 
  3.892702670575999*^9}},ExpressionUUID->"6087060a-4f2c-4be1-a7be-\
33346f093d6c"],

Cell["\<\
This definition is only consistent when the Directional Derivative is acting \
on a Scalar object. This definition is not consistent when the directional \
derivative is acting on a vector or any other tensorial object because one \
also needs to take into account the perturbation to the connection. This is \
not an issue in this notebook because I use the NP formalism to convert all \
tensorial objects into scalars.\
\>", "Text",
 CellChangeTimes->{{3.892702673289112*^9, 3.8927028113214703`*^9}, {
  3.8940010246141467`*^9, 
  3.894001026989956*^9}},ExpressionUUID->"a07b6787-e5a9-4442-a6e9-\
3e9608f94628"],

