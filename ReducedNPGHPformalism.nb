Cell[CellGroupData[{

Cell["Perturbed spinors equation list :", "Section",
 CellChangeTimes->{{3.7662178735620117`*^9, 
  3.7662178964680204`*^9}},ExpressionUUID->"508d91ee-3f65-41c8-ad42-\
942af496db06"],

Cell["\<\
Here I derive independent equations for each Perturbed Spin Coefficients from \
the previous sections equations. The results are expressions for the \
Perturbed Spin Coefficients in terms of only zeroth order spin coefficients \
and the metric perturbation.\
\>", "Text",
 CellChangeTimes->{{3.771932848097975*^9, 3.7719328537918944`*^9}, {
  3.7719329134887843`*^9, 3.7719329644788737`*^9}, {3.8927109518694577`*^9, 
