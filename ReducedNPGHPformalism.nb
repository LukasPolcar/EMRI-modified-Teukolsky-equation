Cell[CellGroupData[{

Cell["\<\
Relating Spin Coefficients to (Christoffel) Connections (which represent \
Ricci Rotation Coefficients)\
\>", "Subsection",
 CellChangeTimes->{
  3.762862187358405*^9, 3.773653529044669*^9, {3.8927014769978876`*^9, 
   3.892701480153654*^9}},ExpressionUUID->"da97584b-9808-43df-adb2-\
6f1f0e437450"],

Cell["\<\
While xAct calls the connection of the NP partial derivative (PDNP) relative \
to the covariant derivative (CD) Christoffel, these connections are not \
Christoffel symbols and obey different symmetries. The connection, \
ChristoffelCDPDNP, are related to Ricci Rotation coefficients.\
\>", "Text",
 CellChangeTimes->{{3.892701486632608*^9, 
  3.8927017238624496`*^9}},ExpressionUUID->"68c329c2-45c0-452e-a544-\
14f11a27f05b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RotationCoeffs", "=", 
  RowBox[{"Map", "[", 
   RowBox[{"TraceBasisDummy", ",", 
    RowBox[{"AllSpinCoefficients", "//", 
     RowBox[{"ToBasis", "[", "NP", "]"}]}], ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
