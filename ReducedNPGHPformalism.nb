Cell["\<\
We also need to teach GHPWeightOf how to behave when acting on differential \
expressions.\
\>", "MathCaption",
 TextJustification->1.,ExpressionUUID->"4220b1cb-0148-48a8-8738-f2032ccbf396"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", 
    RowBox[{
     RowBox[{"\[CapitalTheta]", "[", 
      RowBox[{"ind_", "?", "CIndexQ"}], "]"}], "@", "sc_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Part", "[", 
       RowBox[{
        RowBox[{"GHPWeightOf", "@", 
         RowBox[{"\[CapitalTheta]", "[", "ind", "]"}]}], ",", "1"}], "]"}], 
      "+", 
