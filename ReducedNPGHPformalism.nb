     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], ",", 
    RowBox[{
     RowBox[{"GHPWeightOf", "@", 
      RowBox[{"lNP", "[", 
       RowBox[{
        RowBox[{"LI", "[", "order_", "]"}], ",", " ", 
        RowBox[{"{", 
