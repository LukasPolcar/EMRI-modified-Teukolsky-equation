Cell[CellGroupData[{

Cell["RicciIDRuleNonGHPWeightedNPSC", "Subsubsection",
 CellChangeTimes->{3.7773666490748215`*^9, 
  3.777373556046011*^9},ExpressionUUID->"a5e0ecd8-134e-4f09-9b36-\
f7720a024655"],

Cell["\<\
Here I derive a useful rule that can be used to simplify equations in NP form \
(which will be crucial for converting equations from NP form to GHP form \
because it eliminates quantities that appear to have poorly defined spin and \
boost weights\
\>", "Text",
 CellChangeTimes->{{3.8927038737820435`*^9, 
  3.892703966085517*^9}},ExpressionUUID->"56495169-d61f-45ba-b2b4-\
badad2fef6a7"],

