Cell[CellGroupData[{

Cell["ORG Hertz potential", "Section",
 CellChangeTimes->{{3.9205240389620466`*^9, 
  3.920524046471588*^9}},ExpressionUUID->"d815baf8-823b-4089-9990-\
197279453913"],

Cell["\<\
There are two main definitions of the Hertz potential. In our calculations we \
use the definition as found in  Pound and Wardell  \
https://link.springer.com/rwe/10.1007/978-981-15-4702-7_38-1 but here we also \
check the other common definition.  We also derive here the Teukolsky \
operator and source in the GHP form\
\>", "Text",
 CellChangeTimes->{{3.9302994714965353`*^9, 3.9302995210090847`*^9}, {
  3.9302998494420056`*^9, 3.9302998922961054`*^9}, {3.930300133491644*^9, 
  3.9303001651111655`*^9}, {3.9303002474971743`*^9, 3.9303002760616827`*^9}, {
  3.959092345482542*^9, 
  3.959092346846489*^9}},ExpressionUUID->"2fc3121d-5081-4d87-8cfb-\
7b43817a9c06"],

Cell[CellGroupData[{

Cell["The formalism as  in Pound and Wardell BHPT", "Subsubsection",
 CellChangeTimes->{{3.9200916098040905`*^9, 3.9200916375003614`*^9}, {
  3.9200918607723722`*^9, 3.9200918655000334`*^9}, {3.920434451184552*^9, 
  3.920434454648836*^9}},ExpressionUUID->"6b46fa75-c601-46e5-bcc5-\
c9180c38062b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefTensorPerturbation", "[", 
   RowBox[{
    RowBox[{"PsiHZ", "[", 
     RowBox[{"LI", "[", "order", "]"}], "]"}], ",", 
    RowBox[{"PsiHZ", "[", "]"}], ",", "M4", ",", 
    RowBox[{"Dagger", "\[Rule]", "Complex"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "@", "PsiHZ"}], "^=", 
   "\"\<\!\(\*SubscriptBox[\(\[CapitalPsi]\), \(HZ\)]\)\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PrintAs", "@", "PsiHZ\[Dagger]"}], "^=", 
   "\"\<\!\(\*SubscriptBox[OverscriptBox[\(\[CapitalPsi]\), \(_\)], \(HZ\)]\)\
\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "@", 
    RowBox[{"PsiHZ", "[", "]"}]}], "^=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "@", 
    RowBox[{"PsiHZ\[Dagger]", "[", "]"}]}], "^=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "4"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "@", 
    RowBox[{"PsiHZ", "[", 
