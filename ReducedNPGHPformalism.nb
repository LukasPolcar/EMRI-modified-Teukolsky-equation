Cell[CellGroupData[{

Cell["Perturbing Spin Coefficients", "Section",
 CellChangeTimes->{{3.7631897375821657`*^9, 3.763189745662788*^9}, {
  3.7736542139486294`*^9, 
  3.773654218832018*^9}},ExpressionUUID->"ca8ff22b-0eaa-4438-bebc-\
edaba61b61fc"],

Cell["\<\
Here I derive the perturbed Newman-Penrose spin Coefficients using the same \
method as Ref. M. Campanelli and C. O. Lousto, Second order gauge invariant \
gravitational perturbations of a Kerr black hole, Physical Review D 59, \
124022 (1999) 
(there are small corrections to some of their final formulas).\
\>", "Text",
 CellChangeTimes->{{3.771932182335955*^9, 3.7719322389241943`*^9}, {
  3.892710298462237*^9, 3.892710316078003*^9}, {3.8927103490759697`*^9, 
  3.8927103934999833`*^9}},ExpressionUUID->"1817ea65-cc1e-4889-a59e-\
0ec8b9e575bb"],

Cell[CellGroupData[{

Cell["\<\
Recalling the NP Commutator equations and defining a rule for such:\
\>", "Subsection",
