Cell["\<\
SWSH[2, li, mi]*(-(Coefm[2, li]*Coefp[1, li]*ksim1[]^2*Radf[2, li, mi]) + \
3*rsp[]*(-2*es[]*Radf[2, li, mi] - 2*es\[Dagger][]*Radf[2, li, mi] + PDNP[{1, \
-NP}][Radf[2, li, mi]]) + 2*(Radf[2, li, mi]*PDNP[{1, -NP}][esp[]] + \
esp[]*PDNP[{1, -NP}][Radf[2, li, mi]]) + 
  2*(Radf[2, li, mi]*PDNP[{1, -NP}][esp\[Dagger][]] + esp\[Dagger][]*PDNP[{1, \
-NP}][Radf[2, li, mi]]) - 3*Radf[2, li, mi]*(PsiCD2[] - es[]*rsp[] - es\
\[Dagger][]*rsp[] + rs[]*rsp[] - PDNP[{1, -NP}][rsp[]]) + PDNP[{1, \
-NP}][PDNP[{2, -NP}][Radf[2, li, mi]]] - 
  es[]*(2*esp[]*Radf[2, li, mi] + 2*esp\[Dagger][]*Radf[2, li, mi] + PDNP[{2, \
-NP}][Radf[2, li, mi]]) - es\[Dagger][]*(2*esp[]*Radf[2, li, mi] + 2*esp\
\[Dagger][]*Radf[2, li, mi] + PDNP[{2, -NP}][Radf[2, li, mi]]) - \
rs[]*(2*esp[]*Radf[2, li, mi] + 2*esp\[Dagger][]*Radf[2, li, mi] + PDNP[{2, \
-NP}][Radf[2, li, mi]]))\
\>", "Output",
