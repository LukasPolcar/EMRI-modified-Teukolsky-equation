Cell["\<\
SWSH[-2, li, mi]*(-(Coefm[-1, li]*Coefp[-2, li]*ksim1[]^2*RadPsi4[-2, li, \
mi]) - esp[]*(2*es[]*RadPsi4[-2, li, mi] + 2*es\[Dagger][]*RadPsi4[-2, li, \
mi] + PDNP[{1, -NP}][RadPsi4[-2, li, mi]]) - \
esp\[Dagger][]*(2*es[]*RadPsi4[-2, li, mi] + 2*es\[Dagger][]*RadPsi4[-2, li, \
mi] + PDNP[{1, -NP}][RadPsi4[-2, li, mi]]) - 
  5*rsp[]*(2*es[]*RadPsi4[-2, li, mi] + 2*es\[Dagger][]*RadPsi4[-2, li, mi] + \
PDNP[{1, -NP}][RadPsi4[-2, li, mi]]) - rs[]*(-2*esp[]*RadPsi4[-2, li, mi] - \
2*esp\[Dagger][]*RadPsi4[-2, li, mi] + PDNP[{2, -NP}][RadPsi4[-2, li, mi]]) + 
  2*(RadPsi4[-2, li, mi]*PDNP[{2, -NP}][es[]] + es[]*PDNP[{2, \
-NP}][RadPsi4[-2, li, mi]]) + 2*(RadPsi4[-2, li, mi]*PDNP[{2, -NP}][es\
\[Dagger][]] + es\[Dagger][]*PDNP[{2, -NP}][RadPsi4[-2, li, mi]]) - \
RadPsi4[-2, li, mi]*(3*PsiCD2[] + esp[]*rs[] + esp\[Dagger][]*rs[] - \
5*rs[]*rsp[] + PDNP[{2, -NP}][rs[]]) + 
  PDNP[{2, -NP}][PDNP[{1, -NP}][RadPsi4[-2, li, mi]]])\
\>", "Output",
