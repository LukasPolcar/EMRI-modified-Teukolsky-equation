Cell[CellGroupData[{

Cell["\<\
GHP differential operators and their conversion to NP Derivatives\
\>", "Subsection",
 CellChangeTimes->{{3.892716619418787*^9, 3.8927166288747406`*^9}, 
   3.894001404179534*^9},ExpressionUUID->"ee2e1374-e539-4260-b599-\
8f24cc5f15ee"],

Cell[TextData[{
 "The GHP differential operators are constructed by the spin coefficients \
with ill-defined GHP weights with the four ",
 StyleBox["NP", "Output"],
 " directional derivatives (which also have ill-defined GHP weights). The \
result is a set of four differential operators having good transformation \
properties under spin and boost. "
}], "Text",
 CellChangeTimes->{
  3.773034379715643*^9, {3.8927162437546186`*^9, 3.8927162848945484`*^9}},
 TextJustification->1.,
 FontWeight->"Plain",ExpressionUUID->"699c745f-abdf-45a9-a93e-5e0b87a562f7"],

Cell[TextData[{
 "The GHP differential operators can be regarded as the \"components\" of a \
certain differential operator which we define next.  This  operator is not a \
true covariant derivative but just a differential operator acting on scalars, \
 so we need to use some primitive ",
 StyleBox["xAct`", "Output"],
 " instructions in order to create it. We use the notation ",
 Cell[BoxData[
  SubscriptBox["\[CapitalTheta]", "a"]], "Output",
  CellChangeTimes->CompressedData["
1:eJxTTMoPSmVkYGDQAmIBr5bssvqXjuvqQupB9HqjOe9B9DfW+h8gmkNb/R+I
vp87dWUFkP7ld+1EFZD+sKJl3hwgzbTH7xiI9rrDoz65+aVj++9AGxDN1Rt9
FkQrXd8wYy6QduqQmrwVSO/7eTpgG5Deu82sfTuQvnFf/PshIP1rycwnz4H0
pv8FTpwtLx19X8zlsQPSy6wuxjoAabPbmze6AmmhZ56zZwLpeX5x1zcD6Tnf
RJzSWl867vCfWN8HpJ3OeclMANJCBmZzJwFpmT9qf+YCaYmVth47gHT1vsdm
x4C0x5Stj24BaZVfNfdZ2l46+phr6ugCaSuRB40RQJorio1HuuOl44ngn+Hr
gPQ3Pn2x30A691hJ5x8gLfB600m2TqC7om0S2YF0sbdKLogGAK3csIk=
   "],ExpressionUUID->"e6d45861-713a-412f-85c4-95552e564734"],
 " as a representation for it."
}], "MathCaption",
 TextJustification->1.,ExpressionUUID->"5075a09c-5dad-4191-8bde-1881eeef7ff9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CovDQ", "[", "\[CapitalTheta]", "]"}], "^=", "True"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xAct`xTensor`Private`MakeLinearDerivative", "[", 
   RowBox[{
    RowBox[{"{", 
