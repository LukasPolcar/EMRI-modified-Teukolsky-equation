Cell[CellGroupData[{

Cell["Boost and spin weights", "Subsection",ExpressionUUID->"d588e42e-5d4c-42fc-be36-20ff870c24c4"],

Cell[TextData[{
 "The GHP formalism only admits ",
 StyleBox["weighted quantities",
  FontSlant->"Italic"],
 ". In this subsection we introduce a command, called ",
 StyleBox["GHPWeightOf", "Input"],
 ", which computes the boost and spin weight of any quantity. These are \
integers which are kept in a list.  The command ",
 StyleBox["GHPWeightOf", "Input"],
 " also checks that the GHP weight of the terms of any sum all agree, \
throwing an error otherwise. "
}], "Text",
 TextJustification->1.,ExpressionUUID->"8ae8eeb6-8290-4b78-acb4-3d867d896e46"],

Cell[CellGroupData[{

Cell["Defining GHPWeightOf operator and its error message", "Subsubsection",
 CellChangeTimes->{{3.772945471347541*^9, 3.7729454887019153`*^9}, {
   3.892713150520796*^9, 3.8927131508372593`*^9}, 
   3.8940013411043363`*^9},ExpressionUUID->"a87753e4-b60c-4f21-8989-\
64f98ba59bc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "::", "usage"}], "=", 
   "\"\<GHPWeightOf[expr] returns the GHP boost and spin weight of any \
expression. If the expression is not weighted, then an error message is \
returned\>\""}], ";"}]], "Input",
 CellLabel->
  "In[500]:=",ExpressionUUID->"4bb78273-a889-447a-b115-7001d8743b0f"],

Cell["Weights of integers, rationals and complex numbers.", "MathCaption",ExpressionUUID->"593e1747-7f3c-4767-a3ee-99964ed05d67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", 
    RowBox[{"num_", "?", "IntegerQ"}], " ", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", "_Rational", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", "_Complex", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0"}], "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[501]:=",ExpressionUUID->"1fb72045-dfd5-49d4-bb09-62e1a2164410"],

Cell["Weights of products.", "MathCaption",ExpressionUUID->"3af3c1e4-81b6-46fd-9f02-1a348ee60fac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", "expr_Times", "]"}], ":=", 
   RowBox[{"Apply", "[", 
    RowBox[{"Plus", ",", 
     RowBox[{"GHPWeightOf", "/@", 
      RowBox[{"Level", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[504]:=",ExpressionUUID->"8051f558-4200-4247-8ee8-580c4a57d7f3"],

Cell["Weights of sums", "MathCaption",ExpressionUUID->"bc47a7c1-0859-48da-9c7e-e5f51e8bd78b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "@", "expr_Plus"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "@", 
       RowBox[{"Union", "[", 
        RowBox[{"GHPWeightOf", "/@", 
         RowBox[{"Level", "[", 
          RowBox[{"expr", ",", "1"}], "]"}]}], "]"}]}], ">", "1"}], ",", 
     RowBox[{"Throw", "@", 
      RowBox[{"Message", "[", 
       RowBox[{"GHPWeightOf", "::", "Error"}], "]"}]}], ",", 
     RowBox[{"First", "@", 
      RowBox[{"Union", "[", 
       RowBox[{"GHPWeightOf", "/@", 
        RowBox[{"Level", "[", 
         RowBox[{"expr", ",", "1"}], "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "::", "Error"}], "=", 
   "\"\<Inconsistent weights on Plus expression\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[505]:=",ExpressionUUID->"71ff93a0-bd90-4d1f-b2c8-71feeb542b3f"],

Cell["Weights of powers", "MathCaption",ExpressionUUID->"e13c4c2e-9b5c-4ece-a5f2-9d08973a2c65"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GHPWeightOf", "[", 
    RowBox[{"expr_", "^", 
     RowBox[{"(", 
      RowBox[{"n_", "?", "IntegerQ"}], ")"}]}], "]"}], ":=", 
   RowBox[{"n", " ", 
    RowBox[{"GHPWeightOf", "@", "expr"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[507]:=",ExpressionUUID->"2eaf913c-8523-4392-bc50-460242143884"]
}, Open  ]],

