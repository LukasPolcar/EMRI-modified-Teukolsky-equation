Cell[BoxData[
 RowBox[{"GHPToHalfNP", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalTheta]", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", "\[Eta]_", "]"}], "/;", 
      RowBox[{
       RowBox[{"Head", "[", 
        RowBox[{"GHPWeightOf", "@", "\[Eta]"}], "]"}], "\[Equal]", "List"}]}],
      "\[RuleDelayed]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"First", "[", 
         RowBox[{"GHPWeightOf", "[", "\[Eta]", "]"}], "]"}]}], " ", 
       InterpretationBox[
        StyleBox["\[Epsilon]",
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`es[],
        Editable->False], " ", "\[Eta]"}], "-", 
      RowBox[{
       RowBox[{"Last", "[", 
        RowBox[{"GHPWeightOf", "[", "\[Eta]", "]"}], "]"}], " ", 
       InterpretationBox[
        StyleBox[
         OverscriptBox["\[Epsilon]", "_"],
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`es\[Dagger][],
        Editable->False], " ", "\[Eta]"}], "+", 
      RowBox[{
       RowBox[{"PDNP", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", "\[Eta]", "]"}]}]}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\[CapitalTheta]", "[", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
          RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", "\[Eta]_", "]"}], "/;", 
