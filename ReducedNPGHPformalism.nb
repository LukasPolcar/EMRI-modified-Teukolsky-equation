Cell[CellGroupData[{

Cell["Bianchi Identities", "Subsection",
 CellChangeTimes->{{3.760860727024743*^9, 3.760860733881933*^9}, 
   3.8927033105681047`*^9},ExpressionUUID->"6dfacabe-4453-420f-bb62-\
f00105779a9d"],

Cell["\<\
Bianchi Identity function (the identities equal zero), a, b, c, d, and f are \
the tetrad vector numbers. Relates the spin coefficients to the Weyl tensors \
and components of the stress - energy tensor .\
\>", "Text",
 CellChangeTimes->{{3.892703244433544*^9, 
  3.8927032732720785`*^9}},ExpressionUUID->"42494f3b-624e-4cc6-9878-\
7f750b5a28e3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Bianchi", "[", 
    RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_", ",", "f_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"ChangeCovD", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"3", "*", 
           RowBox[{"Antisymmetrize", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"CD", "[", 
               RowBox[{"-", "f"}], "]"}], "@", 
              RowBox[{"RiemannCD", "[", 
               RowBox[{
                RowBox[{"-", "a"}], ",", 
                RowBox[{"-", "b"}], ",", 
                RowBox[{"-", "c"}], ",", 
                RowBox[{"-", "d"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "c"}], ",", 
               RowBox[{"-", "d"}], ",", 
               RowBox[{"-", "f"}]}], "}"}]}], "]"}]}], "//", "ToCanonical"}], 
         ",", "CD", ",", "PDNP"}], "]"}], "//", "RiemannToWeyl"}], "//", 
      RowBox[{"ToBasis", "[", "NP", "]"}]}], "//", 
     RowBox[{"ToBasis", "[", "NP", "]"}]}], "//", "TraceBasisDummy"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.7614772149299803`*^9, 3.7614772552762156`*^9}, {
   3.7614772903114047`*^9, 3.7614773224002376`*^9}, 3.76147751299278*^9, {
