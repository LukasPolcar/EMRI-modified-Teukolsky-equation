Cell[BoxData[
 RowBox[{
  RowBox[{"RadTeuk00adjHz", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], "/", 
     RowBox[{
      RowBox[{"r", "[", "]"}], "^", "2"}]}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Coefm", "[", 
          RowBox[{"2", ",", "li"}], "]"}], "*", 
         RowBox[{"Coefp", "[", 
          RowBox[{"1", ",", "li"}], "]"}], "*", 
         RowBox[{
          RowBox[{"ksim1", "[", "]"}], "^", "2"}], "*", 
         RowBox[{"Radf", "[", 
          RowBox[{"2", ",", "li", ",", "mi"}], "]"}]}], ")"}]}], "+", 
      RowBox[{"3", "*", 
       RowBox[{"rsp", "[", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], "*", 
          RowBox[{"es", "[", "]"}], "*", 
          RowBox[{"Radf", "[", 
           RowBox[{"2", ",", "li", ",", "mi"}], "]"}]}], "-", 
         RowBox[{"2", "*", 
          RowBox[{"es\[Dagger]", "[", "]"}], "*", 
          RowBox[{"Radf", "[", 
           RowBox[{"2", ",", "li", ",", "mi"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"PDNP", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", 
          RowBox[{"Radf", "[", 
           RowBox[{"2", ",", "li", ",", "mi"}], "]"}], "]"}]}], ")"}]}], "+", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Radf", "[", 
           RowBox[{"2", ",", "li", ",", "mi"}], "]"}], "*", 
          RowBox[{
           RowBox[{"PDNP", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", 
           RowBox[{"esp", "[", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"esp", "[", "]"}], "*", 
          RowBox[{
           RowBox[{"PDNP", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", 
           RowBox[{"Radf", "[", 
            RowBox[{"2", ",", "li", ",", "mi"}], "]"}], "]"}]}]}], ")"}]}], 
      "+", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Radf", "[", 
           RowBox[{"2", ",", "li", ",", "mi"}], "]"}], "*", 
          RowBox[{
           RowBox[{"PDNP", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", 
           RowBox[{"esp\[Dagger]", "[", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"esp\[Dagger]", "[", "]"}], "*", 
          RowBox[{
           RowBox[{"PDNP", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "NP"}]}], "}"}], "]"}], "[", 
           RowBox[{"Radf", "[", 
            RowBox[{"2", ",", "li", ",", "mi"}], "]"}], "]"}]}]}], ")"}]}], 
      "-", 
      RowBox[{"3", "*", 
       RowBox[{"Radf", "[", 
        RowBox[{"2", ",", "li", ",", "mi"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PsiCD2", "[", "]"}], "-", 
         RowBox[{
          RowBox[{"es", "[", "]"}], "*", 
          RowBox[{"rsp", "[", "]"}]}], "-", 
         RowBox[{
          RowBox[{"es\[Dagger]", "[", "]"}], "*", 
          RowBox[{"rsp", "[", "]"}]}], "+", 
         RowBox[{
          RowBox[{"rs", "[", "]"}], "*", 
          RowBox[{"rsp", "[", "]"}]}], "-", 
         RowBox[{
          RowBox[{"PDNP", "[", 
