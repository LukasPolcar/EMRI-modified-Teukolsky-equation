     Sqrt[-2 + li + li^2]*R*(-2*MB + R)*(2*Sqrt[MB]*Sqrt[R]*(2*I + \
omega*R)*SWSHtheta[-1, li, -mi, Pi/2] + Sqrt[li*(1 + li)]*(-2*MB + \
R)*SWSHtheta[0, li, -mi, Pi/2])) + 
   2*Sqrt[MB]*(2*MB - R)*R*(Sqrt[MB]*(MB - I*omega*R^2)*SWSHtheta[-2, li, \
-mi, Pi/2] - I*Sqrt[-2 + li + li^2]*Sqrt[R]*(-2*MB + R)*SWSHtheta[-1, li, \
-mi, Pi/2])*Derivative[0, 0, 0, 1][RadHZ\[Dagger]][li, mi, omega, R]))/(24*MB \
