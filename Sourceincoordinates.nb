Cell[CellGroupData[{

Cell["Description", "Chapter",
 CellChangeTimes->{{3.9587366036434956`*^9, 
  3.958736606879513*^9}},ExpressionUUID->"21b6f40b-2539-2442-ab92-\
cc570d60b5ab"],

Cell[TextData[{
 StyleBox["This is one of four Mathematica notebooks created by Luk\[AAcute]\
\[SHacek] Polcar that form the supplemental material to the 2025 paper \
\[OpenCurlyDoubleQuote]Towards relativistic inspirals into black holes \
surrounded by matter\[CloseCurlyDoubleQuote] by Luk\[AAcute]\[SHacek] Polcar \
and Vojt\[EHacek]ch Witzany.\n",
  FontWeight->"Bold"],
 "This notebook takes as input the results from the other  notebooks and \
evaluates the modified effective source localized on the matter shell in \
Schwarzschild coordinates. In particular, it solves the (1,1) equations for \
the ring, which contributes to the total source.  This part corresponds to \
Section IV of the paper.\nSome lines and sections  are commented out or are \
set as not evaluatable for a quick evaluation of the entire notebook."
}], "Text",
 CellChangeTimes->{{3.958738032644289*^9, 3.9587380331210365`*^9}, {
   3.9587411272754803`*^9, 3.9587411355886955`*^9}, {3.9587411680395737`*^9, 
   3.9587412193750343`*^9}, {3.959333499435974*^9, 3.959333527788666*^9}, {
   3.9593339464791946`*^9, 3.9593340217871914`*^9}, 
   3.959676855584736*^9},ExpressionUUID->"3ccc5d8b-5e23-3841-883c-\
de0be371afc4"]
}, Open  ]],

