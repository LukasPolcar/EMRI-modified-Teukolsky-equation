R)*Sqrt[R]*((-I)*MB + omega*R^2)*SWSHtheta[1, li, mi, Pi/2] + 
    MB*(8*MB^2 + 2*(-4 + li + li^2)*MB*R + R^2*(2 - li - li^2 - (2*I)*omega*R \
+ 4*omega^2*R^2))*SWSHtheta[2, li, mi, Pi/2])*Derivative[0, 0, 0, \
1][RadHZ][li, mi, omega, R])/(32*R^2*(-3*MB + R));\
