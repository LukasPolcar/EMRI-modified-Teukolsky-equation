Cell[TextData[{
 "The radial part of the source ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"R", "[", 
      SubsuperscriptBox["S", 
       SubscriptBox["r", "r"], 
       RowBox[{"(", 
        RowBox[{"1", ",", "1"}], ")"}]], "]"}], "lm\[Omega]"], 
    RowBox[{"(", "r", ")"}]}], TraditionalForm]],
